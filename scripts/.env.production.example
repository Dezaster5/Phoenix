# Production env for password.avtch.io (server tamirlan@10.10.10.17).
# Copy to the repo root on the server as `.env` and fill in the secrets:
#   cp scripts/.env.production.example .env
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=password.avtch.io,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://password.avtch.io
DJANGO_CORS_ALLOWED_ORIGINS=https://password.avtch.io
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=
DJANGO_CORS_ALLOW_CREDENTIALS=False
DJANGO_CORS_EXPOSE_HEADERS=content-disposition
DJANGO_CORS_ALLOW_HEADERS_EXTRA=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret

POSTGRES_DB=phoenix
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_SSLMODE=

ALLOW_PASSWORDLESS_LOGIN=True
PASSWORDLESS_ROLES=employee,head
LOGIN_CHALLENGE_ENABLED=False
LOGIN_CHALLENGE_TTL_MINUTES=10
FRONTEND_BASE_URL=https://password.avtch.io
PUBLIC_SUPPORT_EMAIL=
PUBLIC_LOGIN_REQUEST_SUBJECT=Запрос логина Phoenix Vault
PUBLIC_LOGIN_REQUEST_TEMPLATE=Здравствуйте!\n\nПрошу выдать логин для доступа в Phoenix Vault.\nФИО: ____\nОтдел: ____\nДолжность: ____\nКорпоративная почта: ____\nНужные сервисы: ____\n\nСпасибо!

AVATRACKER_EMPLOYEE_URL=https://avatracker.online/api/v1/employees/{iin}
AVATRACKER_API_TOKEN=
AVATRACKER_AUTH_SCHEME=Bearer
AVATRACKER_TIMEOUT_SECONDS=5
VERIFICATION_CHALLENGE_TTL_MINUTES=15

EMAIL_NOTIFICATIONS_ENABLED=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_HOST_USER=info@avtch.io
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=info@avtch.io
RESEND_API_KEY=
EMAIL_HTTP_TIMEOUT_SECONDS=10

FERNET_KEY=
ASYMMETRIC_PUBLIC_KEY=
ASYMMETRIC_PRIVATE_KEY=
ASYMMETRIC_PUBLIC_KEY_PATH=keys/public_key.pem
ASYMMETRIC_PRIVATE_KEY_PATH=keys/private_key.pem

THROTTLE_LOGIN_BURST=10/min
THROTTLE_LOGIN_SUSTAINED=50/hour
THROTTLE_ACCESS_REQUEST_CREATE=20/day
LOG_LEVEL=INFO

SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# TLS is terminated by the host nginx; it also redirects HTTP -> HTTPS.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
X_FRAME_OPTIONS=DENY
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
CONTENT_SECURITY_POLICY=
PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()
AUDIT_CREDENTIAL_LIST_VIEWS=False

RUN_MIGRATIONS=1
COLLECT_STATIC=1
WHITENOISE_MANIFEST_STRICT=False
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60

VITE_API_URL=/api
# Docker nginx is published on loopback only; the host nginx proxies password.avtch.io here.
NGINX_BIND=127.0.0.1
NGINX_HTTP_PORT=8088
